# Copier en .env :  cp .env.example .env
# Le sujet impose une regle de complexite type aaAA11** (minuscule+majuscule+chiffre+special)

# ---------------------------------------------------------------------
# PostgreSQL (docker compose) — voir docker-compose.yml et init/
# ---------------------------------------------------------------------
POSTGRES_DB=classroomobserv

# Role admin/proprietaire : sert UNIQUEMENT aux migrations et a l'init.
POSTGRES_USER=classroom_admin
POSTGRES_PASSWORD=Admin_aaAA11**

# Role applicatif restreint : c'est CELUI-CI que FastAPI doit utiliser.
# (satisfait l'exigence "ne pas utiliser l'identifiant root / superuser")
APP_DB_PASSWORD=App_bbBB22##

# ---------------------------------------------------------------------
# Backend FastAPI
# ---------------------------------------------------------------------
# Chaine de connexion de FastAPI (utilisateur = classroom_app, role restreint).
#
# /!\ Cette valeur "localhost:5433" ne sert QU'AU DEV LOCAL (uvicorn lance sur ta
#     machine, la base etant exposee sur le port 5433 de l'hote).
#
#     En DOCKER COMPOSE, ce DATABASE_URL est IGNORE : le service "api" recoit sa
#     propre chaine pointant sur le NOM DE SERVICE "db" (voir docker-compose.yml,
#     service api -> DATABASE_URL=...@db:5432/...). Rien a changer ici pour Docker.
DATABASE_URL=postgresql+asyncpg://classroom_app:App_bbBB22##@localhost:5433/classroomobserv

# Secret JWT — generer un vrai secret en prod :  openssl rand -hex 32
JWT_SECRET=change-me-dev-only-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Origines autorisees pour le CORS (front), separees par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Intervalle (secondes) entre deux campagnes de ping des calculateurs (0 = desactive)
PING_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------
# Frontend (Next.js) — sous-module ./frontend, servi via le proxy Caddy (port 80)
# ---------------------------------------------------------------------
# URL de l'API vue par le NAVIGATEUR, FIGEE AU BUILD du front.
# Laisser VIDE : le front appelle /api en same-origin via Caddy (recommande, pas de CORS).
# A ne renseigner que si le front tape une API sur une autre origine.
NEXT_PUBLIC_API_URL=

# Mot de passe du rôle de réplication Postgres (réplica db_replica)
REPLICATION_PASSWORD=Repl_ccCC33##
